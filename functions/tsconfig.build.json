{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "../aliyun/dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["./**/*.ts"],
  "exclude": ["./tsconfig*.json"]
}
